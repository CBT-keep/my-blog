---
import type { ImageMetadata } from "astro";
import type { HeroStickerConfig } from "@/types/config";

interface Props {
	config: HeroStickerConfig;
	avatar: ImageMetadata | string;
	avatarAlt: string;
}

const { config, avatar, avatarAlt } = Astro.props;
const avatarSrc = typeof avatar === "string" ? avatar : avatar.src;
const stickerStyle = [
	`--home-hero-left-eye-x: ${config.eye.xPercent}%`,
	`--home-hero-left-eye-y: ${config.eye.yPercent}%`,
	`--home-hero-right-eye-x: ${config.rightEye.xPercent}%`,
	`--home-hero-right-eye-y: ${config.rightEye.yPercent}%`,
	`--home-hero-mouth-x: ${config.mouth.xPercent}%`,
	`--home-hero-mouth-y: ${config.mouth.yPercent}%`,
	`--home-hero-mouth-width: ${config.mouth.widthPercent}%`,
	`--home-hero-mouth-height: ${config.mouth.heightPercent}%`,
	`--home-hero-mouth-rotation: ${config.mouth.rotation}deg`,
].join(";");
---

<figure
	class="home-hero__sticker home-hero__sticker--avatar"
	style={stickerStyle}
	data-hero-sticker
	data-eye-travel-x={config.eye.travelXPercent}
	data-eye-travel-y={config.eye.travelYPercent}
>
	<img
		class="home-hero__sticker-image home-hero__sticker-avatar-image"
		src={avatarSrc}
		alt={avatarAlt}
		width="512"
		height="512"
		loading="eager"
		decoding="async"
	/>
</figure>
